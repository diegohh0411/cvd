{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "main-window",
    "opener:default",
    "dialog:allow-save",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/**/*.pdf"
        },
        {
          "path": "/**/*.pdf"
        }
      ]
    }
  ]
}
