{
  "name": "cvd",
  "version": "0.5.0",
  "scripts": {
    "ng": "bun run --cwd apps/web ng",
    "start": "bun run --cwd apps/web start",
    "build": "bun run --cwd apps/web build",
    "build:web": "bun run --cwd apps/web build --configuration production,web",
    "watch": "bun run --cwd apps/web watch",
    "test": "bun run --cwd apps/web test",
    "tauri": "cd apps/desktop && tauri",
    "bump": "bun scripts/bump-version.ts"
  },
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  },
  "workspaces": [
    "apps/*"
  ]
}
