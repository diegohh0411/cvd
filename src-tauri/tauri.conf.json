{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cv-decisions",
  "version": "0.1.0",
  "identifier": "com.diego.cv-decisions",
  "build": {
    "beforeDevCommand": "bun run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist/cv-decisions/browser"
  },
  "app": {
    "windows": [
      {
        "title": "cv-decisions",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/llama-server"
    ],
    "macOS": {
      "files": {
        "MacOS/libggml-base.0.dylib": "binaries/libggml-base.0.dylib",
        "MacOS/libggml-blas.0.dylib": "binaries/libggml-blas.0.dylib",
        "MacOS/libggml-cpu.0.dylib": "binaries/libggml-cpu.0.dylib",
        "MacOS/libggml-metal.0.dylib": "binaries/libggml-metal.0.dylib",
        "MacOS/libggml-rpc.0.dylib": "binaries/libggml-rpc.0.dylib",
        "MacOS/libggml.0.dylib": "binaries/libggml.0.dylib",
        "MacOS/libllama-common.0.dylib": "binaries/libllama-common.0.dylib",
        "MacOS/libllama-server-impl.dylib": "binaries/libllama-server-impl.dylib",
        "MacOS/libllama.0.dylib": "binaries/libllama.0.dylib",
        "MacOS/libmtmd.0.dylib": "binaries/libmtmd.0.dylib"
      }
    }
  }
}
