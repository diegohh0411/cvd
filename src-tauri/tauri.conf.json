{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cvd",
  "version": "0.4.1",
  "identifier": "com.diego.cvd",
  "build": {
    "beforeDevCommand": "bun run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist/cvd/browser"
  },
  "app": {
    "windows": [
      {
        "title": "CVD",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'self' blob:",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/llama-server"
    ],
    "macOS": {
      "files": {
        "MacOS/libggml-base.0.dylib": "binaries/libggml-base.0.dylib",
        "MacOS/libggml-blas.0.dylib": "binaries/libggml-blas.0.dylib",
        "MacOS/libggml-cpu.0.dylib": "binaries/libggml-cpu.0.dylib",
        "MacOS/libggml-metal.0.dylib": "binaries/libggml-metal.0.dylib",
        "MacOS/libggml-rpc.0.dylib": "binaries/libggml-rpc.0.dylib",
        "MacOS/libggml.0.dylib": "binaries/libggml.0.dylib",
        "MacOS/libllama-common.0.dylib": "binaries/libllama-common.0.dylib",
        "MacOS/libllama-server-impl.dylib": "binaries/libllama-server-impl.dylib",
        "MacOS/libllama.0.dylib": "binaries/libllama.0.dylib",
        "MacOS/libmtmd.0.dylib": "binaries/libmtmd.0.dylib"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBQjBFNDNGRjZENTZDNjcKUldSbmJOWDJQK1N3Nmxob01MNm14VDEwRjFReTc0ZStoVVpBZjUzOExTTkc5dDhveUZaREk3RDkK",
      "endpoints": [
        "https://github.com/diegohh0411/cvd/releases/latest/download/latest.json"
      ]
    }
  }
}
