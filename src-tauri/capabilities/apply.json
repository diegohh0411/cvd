{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "apply",
  "description": "Auto-apply windows: remote ATS pages may call exactly one command",
  "windows": [
    "apply-*"
  ],
  "remote": {
    "urls": [
      "https://*.greenhouse.io/*",
      "https://greenhouse.io/*",
      "https://jobs.lever.co/*",
      "https://jobs.ashbyhq.com/*"
    ]
  },
  "permissions": [
    "allow-autofill-bridge"
  ]
}
